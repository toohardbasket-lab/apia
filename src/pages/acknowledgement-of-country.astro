---
import Base from "../layouts/Base.astro";
---

<Base
  title="Acknowledgement of Country"
  description="APIA acknowledges the Traditional Owners and Custodians of Country throughout Australia."
>
  <section class="wrap measure">
    <p class="eyebrow">Acknowledgement</p>
    <h1>Acknowledgement of Country</h1>

    <p class="lede">
      The Australian Public Interest Alliance acknowledges the Traditional Owners and
      Custodians of Country throughout Australia, and their continuing connection to land,
      waters and community. We pay our respects to Elders past and present.
    </p>
    <p>APIA is based on Whadjuk Noongar boodja, in Perth, Western Australia.</p>
  </section>
</Base>
